# AI_lib visualization shared style — import via py.style.apply_style()
# Ideas from fig_style.py + cnsplots journal defaults (cite; not a fork).

figure.dpi: 150
savefig.dpi: 600
savefig.bbox: tight
figure.facecolor: white
axes.facecolor: white
axes.unicode_minus: False

font.family: sans-serif
font.sans-serif: Helvetica, Arial, DejaVu Sans
font.size: 11
axes.titlesize: 12
axes.labelsize: 12
xtick.labelsize: 11
ytick.labelsize: 11
legend.fontsize: 10
pdf.fonttype: 42
svg.fonttype: none

axes.spines.top: True
axes.spines.right: True
axes.spines.left: True
axes.spines.bottom: True
axes.linewidth: 0.5
axes.grid: False
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.major.size: 2.5
ytick.major.size: 2.5

lines.linewidth: 1.2
lines.markersize: 4

axes.prop_cycle: cycler('color', ['134aa3', 'f6a3b1', '0b5475', 'dc1f26', '835ca6', 'f7922c', 'fbee61', '981b1e'])
