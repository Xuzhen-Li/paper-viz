<mxCell id="c2" value="&lt;b&gt;Panel grid&lt;/b&gt;: square base cell 43 × 43 mm, gap 3 mm; a panel spans n cells" style="text;html=1;whiteSpace=nowrap;fontFamily=Arial;fontSize=8;fontColor=#000000;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="10.20" y="2.63" width="267.51" height="9.60" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;width of n cells = n × 43 + (n − 1) × 3 mm&lt;/b&gt;   →   1 cell = 43 · 2 cells = 89 · 3 cells = 135 · 4 cells = 181 mm" style="text;html=1;whiteSpace=nowrap;fontFamily=Arial;fontSize=7;fontColor=#333333;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="10.20" y="13.58" width="332.38" height="8.40" as="geometry"/></mxCell>
<mxCell id="c4" value="Double column: 4 cells (181 mm) + 1 mm margin each side = 183 mm.   Single column: 2 cells = 89 mm.   Row height = 43 mm." style="text;html=1;whiteSpace=nowrap;fontFamily=Arial;fontSize=7;fontColor=#333333;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="10.20" y="22.12" width="397.54" height="8.40" as="geometry"/></mxCell>
